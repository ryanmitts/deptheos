                      "state" : "translated",
                      "value" : "%arg render"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg renders"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@, not stacked yet" : {
      "comment" : "VoiceOver label of a Library tile of a stack with no render yet. The placeholder is the stack's name."
    },
    "%@%@%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%2$@%3$@"
          }
        }
      }
    },
    "%lld failed" : {
      "comment" : "Last item of a batch card's line in the Library, in red: how many of its stacks didn't finish.",
