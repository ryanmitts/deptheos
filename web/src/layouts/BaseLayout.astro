---
import "../site/story.css";
import BrandTile from "../components/BrandTile.astro";
import { DOCS, docHref } from "../data/docs.ts";
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_ALT,
  DEFAULT_OG_IMAGE,
  FOOTER_SITE_LINKS,
  NAV,
  REPO,
  SITE_URL,
} from "../data/site.ts";

interface Props {
  /** Page key used for active nav highlighting (e.g. "home", "features", "pyramid", "not-found"). */
  navKey: string;
  /** Page title; " · Deptheos" is appended automatically unless it already contains "Deptheos". */
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  bodyClass?: string;
  /** Set true when the caller renders its own `<div class="docs-layout">...<article id="content">`. */
  customArticle?: boolean;
}

const {
  navKey,
  title,
  description = DEFAULT_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = DEFAULT_OG_ALT,
  noindex = false,
  bodyClass,
  customArticle = false,
} = Astro.props;

const fullTitle = /Deptheos/.test(title) ? title : `${title} · Deptheos`;
const rawPath = Astro.url.pathname;
const path = navKey === "not-found" ? "/404.html" : rawPath.endsWith("/") ? rawPath : `${rawPath}/`;
const canonical = `${SITE_URL}${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://images.deptheos.com" crossorigin />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Deptheos" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    {ogImage === DEFAULT_OG_IMAGE && <meta property="og:image:width" content="1200" />}
    {ogImage === DEFAULT_OG_IMAGE && <meta property="og:image:height" content="803" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/" aria-label="Deptheos">
          <BrandTile class="brand-mark" />
          <span>Deptheos</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          {
            NAV.map(({ key, label, href }) => (
              <a
                href={href}
                aria-current={key === navKey ? "page" : undefined}
                class={key !== navKey && path.startsWith(href) ? "is-section" : undefined}
              >
                {label}
              </a>
            ))
          }
        </nav>
        <div class="topbar-actions">
          <a class="btn primary" href="/download/" aria-current={navKey === "download" ? "page" : undefined}>
            Download
          </a>
          <a
            class="topbar-source"
            href={REPO}
            aria-label="Source code on GitHub"
            title="Source code on GitHub"
          >
            <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" fill="currentColor">
              <path
                d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
              />
            </svg>
          </a>
        </div>
      </div>
    </header>

    {
      customArticle ? (
        <slot />
      ) : (
        <main id="content" tabindex="-1">
          <article>
            <slot />
          </article>
        </main>
      )
    }

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a class="brand" href="/">
            <BrandTile class="brand-mark" />
            <span>Deptheos</span>
          </a>
          <p>A free, open-source focus stacker that runs on your GPU.</p>
        </div>
        <nav class="footer-col" aria-label="Deptheos">
          <h2>Deptheos</h2>
          {
            FOOTER_SITE_LINKS.map(({ label, href }) => (
              <a href={href} aria-current={href === path ? "page" : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
        <nav class="footer-col footer-docs" aria-label="Docs">
          <h2>Docs</h2>
          {
            DOCS.map((doc) => (
              <a href={docHref(doc.key)} aria-current={doc.key === navKey ? "page" : undefined}>
                {doc.short}
              </a>
            ))
          }
        </nav>
      </div>
    </footer>

    <script>
      import "../site.ts";
      if (import.meta.env.DEV) {
        void import("../dev/agentation.tsx").then((m) => m.mountAgentation());
      }
    </script>
    <slot name="scripts" />
  </body>
</html>
