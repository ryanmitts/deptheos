# Rust
/target/

# Release builds (script/bundle-mac.sh, script/bundle-windows.ps1)
/dist/

# The iOS app's version and build number, written by ios/build-xcframework.sh
/ios/Version.xcconfig

# macOS, editors, local tooling
.DS_Store
.idea/
.vscode/
.mcp.json

# Astro starter from the initial commit; referenced by nothing
/site/

# Image types
*.dng
*.jpg
*.jpeg
*.png
*.tiff
*.jxl
*.gputrace

# Allow README images
!images/
!images/**

# The Linux packages' icons (packaging/linux/README.md)
!packaging/linux/icons/**

# Allow aligner test fixtures
!crates/deptheos_aligner/fixtures/**
# ... and the saved-file fixtures (docs/file-formats.md)
!crates/deptheos_app/tests/fixtures/**
# ... and the known images (crates/deptheos_core/tests/integration/known.rs)
!crates/deptheos_core/tests/fixtures/**
# ... and the stackers' golden references (crates/deptheos_core/tests/integration/golden.rs)
!crates/deptheos_core/tests/goldens/**

# The website's media (web/scripts/make-gallery.sh, make-shots.sh, make-lab-assets.ts):
# all of it, so what a deploy uploads is what is committed
!web/public/media/**
# Wrangler's local cache (account id)
.cloudflare/
.wrangler/

# The sample stack the apps carry (ADR-151) is JPEG and is kept.
!samples/**/*.jpg

# Local review folders and agent state, never published
/.feedback/
/shots-review/
/.claude/
