<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- How the release workflow exports the iOS archive (.github/workflows/release.yml):
     uploaded to App Store Connect for TestFlight, signed automatically, with the
     version and build number the archive was made with (ios/Version.xcconfig from
     ios/build-xcframework.sh), never ones Xcode picks. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>T5PCWU6J56</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
