/// Plasma colormap lookup with linear interpolation between entries.
static float3 plasma(float t) {
    t = clamp(t, 0.0f, 1.0f);
    float idx = t * 255.0f;
    uint lo = uint(idx);
    uint hi = min(lo + 1u, 255u);
    float frac = idx - float(lo);
    return mix(plasma_lut[lo], plasma_lut[hi], frac);
}

// MARK: - Depth Focus Map: Plasma + Sidebar Gradient

kernel void focus_colorbar(
    texture2d<float, access::read>  depth_map  [[texture(0)]],
    texture2d<float, access::write> output     [[texture(1)]],
    constant FocusColorbarParams&   params     [[buffer(0)]],
    uint2 gid [[thread_position_in_grid]]
) {
    if (gid.x >= params.total_width || gid.y >= params.total_height) return;

    float4 color;

    if (gid.x < params.image_width) {
        float val = depth_map.read(gid).r;
        color = float4(plasma(val), 1.0f);
    } else if (gid.x >= params.gradient_x &&
               gid.x < params.gradient_x + params.gradient_w &&
               gid.y >= params.gradient_top &&
               gid.y < params.gradient_bottom) {
        float t = float(gid.y - params.gradient_top) / float(max(params.gradient_bottom - params.gradient_top - 1u, 1u));
        color = float4(plasma(t), 1.0f);
    } else {
        color = float4(0.12f, 0.12f, 0.12f, 1.0f);
    }

    output.write(color, gid);
}

// MARK: - Pyramid Focus Map: Sqrt Grayscale

kernel void focus_pyramid_bake(
    texture2d<float, access::read>  focus_map [[texture(0)]],
    texture2d<float, access::write> output    [[texture(1)]],
    uint2 gid [[thread_position_in_grid]]
) {
    uint w = output.get_width();
    uint h = output.get_height();
    if (gid.x >= w || gid.y >= h) return;

    float val = focus_map.read(gid).r;
    float gray = sqrt(clamp(val, 0.0f, 1.0f));
    output.write(float4(gray, gray, gray, 1.0f), gid);
}
